# 统一换行符：文本文件一律 LF，Windows 批处理/PowerShell 脚本保持 CRLF
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.cs text eol=crlf
*.md text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 二进制文件不转换
*.exe binary
*.ico binary
*.png binary
*.bmp binary
*.zip binary
